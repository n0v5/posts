---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const baseUrl = import.meta.env.BASE_URL;
const published = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="mb-10 border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <h1 class="text-3xl font-extrabold tracking-tight">{post.data.title}</h1>
        <a
          href={`${baseUrl}source/${post.id}/`}
          class="mt-1 inline-flex shrink-0 items-center gap-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 px-2.5 py-1 text-xs text-zinc-500 hover:border-zinc-300 hover:text-zinc-900 dark:hover:border-zinc-700 dark:hover:text-zinc-50 transition"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          查看源码
        </a>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-400">
        <time datetime={post.data.pubDate.toISOString()}>发布于 {published}</time>
        {post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-zinc-200 dark:border-zinc-800 px-2 py-0.5 text-xs">
                #{tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <p class="mt-12 text-sm">
      <a href={baseUrl} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-50 transition">
        ← 返回文章列表
      </a>
    </p>
  </article>
</BaseLayout>
