---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const baseUrl = import.meta.env.BASE_URL;
const published = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="mb-10 border-b border-zinc-200 dark:border-zinc-800 pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight mb-3">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-zinc-400">
        <time datetime={post.data.pubDate.toISOString()}>发布于 {published}</time>
        {post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-zinc-200 dark:border-zinc-800 px-2 py-0.5 text-xs">
                #{tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <p class="mt-12 text-sm">
      <a href={baseUrl} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-50 transition">
        ← 返回文章列表
      </a>
    </p>
  </article>
</BaseLayout>
