---
// src/pages/index.astro
// 1. 导入你的布局组件
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content'; // 💡 导入 CollectionEntry

// 获取所有文章，并显式为排序函数的参数声明类型
const posts = (await getCollection('blog')).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// 我们在页面内部需要跳转链接时，直接调用全局变量 import.meta.env.BASE_URL
const baseUrl = import.meta.env.BASE_URL;
---

<!-- 2. 用 BaseLayout 包裹整个页面！ -->
<BaseLayout title="我的个人知识库">
  
  <!-- 下面所有的 HTML 都会被自动塞进 BaseLayout 里的 <slot /> 位置，并自动获得全局样式 -->
  <section class="mb-12">
    <h1 class="text-4xl font-extrabold tracking-tight mb-4">记录 & 总结知识</h1>
    <p class="text-zinc-500 dark:text-zinc-400">
      这里是我存放数学、物理、技术笔记的自建知识库。支持 LaTeX 公式与动态可视化交互组件。
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-bold border-b border-zinc-200 dark:border-zinc-800 pb-2 mb-6">专题</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href={`${baseUrl}html5/`}
        data-featured="html5"
        class="group flex h-full flex-col rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-zinc-300 dark:hover:border-zinc-700 transition"
      >
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-indigo-600 dark:text-indigo-400">Featured · AI Era</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">单文件 · 37 个演示</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2 text-balance group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition">AI 时代的 HTML5 超级大全</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4 line-clamp-4">
          从语义化、表单、媒体、图形到 WebGPU、WebMCP 与浏览器内置 AI。一份可离线保存的完整 HTML5 手册，内置 37 个可交互演示。
        </p>
        <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
          打开大全 <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </span>
      </a>
      <a
        href={`${baseUrl}dart/`}
        data-featured="dart"
        class="group flex h-full flex-col rounded-2xl border border-sky-200 dark:border-sky-900/60 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-sky-300 dark:hover:border-sky-800 transition"
      >
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-sky-600 dark:text-sky-400">Featured · Migration</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">单文件 · 6 个演示</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2 text-balance group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition">Dart 迁移指南：从 C++/Python 到 Dart</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4 line-clamp-4">
          面向已有 C++ 与 Python 经验的开发者：类型系统、健全空安全、mixin/extension、records 与模式匹配、async/Stream、Isolate 并发与工具链。
        </p>
        <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-sky-600 dark:text-sky-400">
          打开指南 <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </span>
      </a>
      <a
        href={`${baseUrl}rust/`}
        data-featured="rust"
        class="group flex h-full flex-col rounded-2xl border border-orange-200 dark:border-orange-900/60 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-orange-300 dark:hover:border-orange-800 transition"
      >
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-orange-600 dark:text-orange-400">Featured · Systems</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">单文件 · 7 个演示</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2 text-balance group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition">Rust 迁移指南：从 C++/Python 到 Rust</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4 line-clamp-4">
          面向已有 C++ 与 Python 经验的开发者：所有权与借用、生命周期、trait/泛型、Result、Send/Sync、async、unsafe/FFI 与 Cargo 工程化。
        </p>
        <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-orange-600 dark:text-orange-400">
          打开指南 <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </span>
      </a>
      <a
        href={`${baseUrl}uiux/`}
        data-featured="uiux"
        class="group flex h-full flex-col rounded-2xl border border-cyan-200 dark:border-cyan-900/60 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-cyan-300 dark:hover:border-cyan-800 transition"
      >
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-cyan-700 dark:text-cyan-300">Featured · Interface</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">单文件 · 12 个实验室</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2 text-balance group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition">从 Flutter 出发：UI/UX 与前端界面通用入门</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4 line-clamp-4">
          先建立可迁移的界面模型，再用 Flutter 3.47 实现：结构、样式、状态、语义、需求简报、无障碍与 AI 协作。
        </p>
        <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-cyan-700 dark:text-cyan-300">
          打开指南 <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
        </span>
      </a>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-bold border-b border-zinc-200 dark:border-zinc-800 pb-2 mb-6">连载</h2>
    <a
      href={`${baseUrl}series/forms-boundary/`}
      data-featured="forms-boundary"
      class="group flex h-full flex-col rounded-2xl border border-indigo-200 dark:border-indigo-900/60 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-800 transition"
    >
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="text-[10px] font-bold tracking-[0.18em] uppercase text-indigo-600 dark:text-indigo-400">New · Series</span>
        <span class="text-[10px] px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-400">31 篇 + 附录</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight mb-2 text-balance group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition">形式的边界：元数学、集合论与逻辑</h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed mb-4">
        从一阶逻辑、可计算性与 Gödel，到 ZFC、力迫、非经典逻辑与数学哲学。强调语法与语义的分工、公理的动机，以及每个比喻的失效边界。
      </p>
      <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
        进入系列 <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
      </span>
    </a>
  </section>

  <section class="space-y-8">
    <h2 class="text-xl font-bold border-b border-zinc-200 dark:border-zinc-800 pb-2">最近文章</h2>
    {posts.length === 0 ? (
      <p class="text-zinc-400">暂无文章。</p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post: CollectionEntry<'blog'>) => (
          <li class="group">
            <span class="text-xs text-zinc-400 block mb-1">
              {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <a href={`${baseUrl}${post.id}/`} class="text-lg font-semibold group-hover:text-zinc-600 dark:group-hover:text-zinc-300 transition">
              {post.data.title}
            </a>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-2">
              {post.data.description}
            </p>
          </li>
        ))}
      </ul>
    )}
  </section>

</BaseLayout>